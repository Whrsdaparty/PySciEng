@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/lv2/vocal2midi>
    a lv2:Plugin ;
    doap:name "Vocal2MIDI MVP (Bridge)" ;
    rdfs:comment "Linux-first MVP wrapper for offline monophonic vocal to MIDI." ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "audio_in" ;
        lv2:name "Audio In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out" ;
        lv2:name "Audio Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "analyze_trigger" ;
        lv2:name "Analyze" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        pprops:toggled true
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "quantize_grid" ;
        lv2:name "Quantize Grid" ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "quantize_strength" ;
        lv2:name "Quantize Strength" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "min_note_ms" ;
        lv2:name "Min Note Length (ms)" ;
        lv2:minimum 10 ;
        lv2:maximum 1000 ;
        lv2:default 80
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "gap_merge_ms" ;
        lv2:name "Gap Merge (ms)" ;
        lv2:minimum 0 ;
        lv2:maximum 500 ;
        lv2:default 40
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "vibrato_smoothing" ;
        lv2:name "Vibrato Smoothing" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.5
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "min_confidence" ;
        lv2:name "Min Confidence" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0.4
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "octave_shift" ;
        lv2:name "Octave Shift" ;
        lv2:minimum -2 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "start_offset_ms" ;
        lv2:name "Start Offset (ms)" ;
        lv2:minimum -500 ;
        lv2:maximum 500 ;
        lv2:default 0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "export_trigger" ;
        lv2:name "Export MIDI" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        pprops:toggled true
    ] .
